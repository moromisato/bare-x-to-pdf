 <office:body>
  <office:spreadsheet>
   <table:calculation-settings table:case-sensitive="false" table:automatic-find-labels="false" table:use-regular-expressions="false" table:use-wildcards="true" table:null-year="1950">
    <table:iteration table:maximum-difference="0.0001"/>
   </table:calculation-settings>
   <table:table table:name="Sheet1" table:style-name="ta1">
    <office:forms form:automatic-focus="false" form:apply-design-mode="false"/>
    <table:table-column table:style-name="co1" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co1" table:number-columns-repeated="16383"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Functional Requirements</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Integrated Check Valve: Must maintain system residual pressure for at least 15 minutes after shutdown to ensure &quot;one-touch&quot; engine starting.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Pressure Relief Valve: Must trigger if the line is obstructed to prevent fuel line rupture.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Fuel Compatibility: Fully compatible with Gasoline, E85 (Ethanol blends up to 85%), and Diesel.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Priming: Must be self-priming from a dry state within 1.5 seconds of activation.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>3. Mechanical &amp; Material Specs</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Pump Mechanism: Regenerative Turbine (chosen for quiet operation and low pulsation).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Housing Material: Anodized Aluminum (corrosion-resistant).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Internal Commutator: Carbon-matrix (designed for high-conductivity and resistance to Ethanol corrosion).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Inlet/Outlet: 8mm Barbed / 11mm Flanged (Standard universal fit).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Filtration: Integrated 30-micron intake &quot;sock&quot; filter.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>4. Electrical Requirements</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Input Voltage Range: 9V to 16V DC.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Connection: Weather-sealed 2-pin connector (positive/negative).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>RFI Suppression: Must include internal capacitors to prevent interference with the vehicle&apos;s radio and ECU signals.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Duty Cycle: Continuous (100%).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>5. Environmental &amp; Safety Constraints</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Operating Temperature: −40°C to +80°C.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Vibration Resistance: Must withstand 10G of force without mechanical failure.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Submersion: Designed for permanent immersion in fuel; all seals must be Viton or Nitrile.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Thermal Protection: Integrated thermal fuse to shut down power if the motor exceeds 120°C (due to running dry).</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>6. Failure Modes &amp; Mitigation</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Run-Dry Scenario: Pump is designed to survive up to 60 seconds of &quot;dry run&quot; (no fuel) without permanent bearing damage.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce1" office:value-type="string" calcext:value-type="string">
      <text:p>Contamination: Intake screen prevents debris &gt;30μm from entering the turbine chamber.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro1" table:number-rows-repeated="2">
     <table:table-cell table:style-name="ce2"/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro2" table:number-rows-repeated="1048526">
     <table:table-cell/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell/>
     <table:table-cell table:style-name="Default" table:number-columns-repeated="16383"/>
    </table:table-row>
   </table:table>
