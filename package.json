{
  "name": "bare-x-to-pdf",
  "version": "0.2.0",
  "description": "Convert Word, PowerPoint, Excel and OpenDocument files to PDF for Bare: a Rust engine on Typst",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "cmake",
    "core/Cargo.toml",
    "core/Cargo.lock",
    "core/src",
    "core/include",
    "fonts",
    "NOTICE.md"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier . --write",
    "lint": "prettier . --check && lunte",
    "test": "npm run test:bare",
    "test:bare": "brittle-bare test/all.mjs",
    "test:generate": "brittle-make-test test/all.mjs test/*.js",
    "bench": "bare bench/run.js",
    "bench:text": "bare bench/text.js",
    "prebuild": "bare-make generate && bare-make build && bare-make install --prefix npm/$(bare -p 'Bare.platform + \"-\" + Bare.arch')/prebuilds && bare scripts/link-host.js",
    "packages": "bare scripts/platform-packages.js && prettier --write npm"
  },
  "author": "Tether Inc",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tetherto/bare-x-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/tetherto/bare-x-to-pdf/issues"
  },
  "homepage": "https://github.com/tetherto/bare-x-to-pdf",
  "keywords": [
    "bare",
    "docx",
    "pptx",
    "xlsx",
    "odf",
    "pdf",
    "typst",
    "convert"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bare-path": "^3.0.0",
    "bare-url": "^2.4.1"
  },
  "devDependencies": {
    "bare-fs": "^4.0.0",
    "bare-pdfium": "^1.3.0",
    "bare-zlib": "^1.0.0",
    "brittle": "^4.1.0",
    "cmake-bare": "^1.8.3",
    "cmake-fetch": "^1.5.1",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0"
  },
  "imports": {
    "#binding": {
      "android": {
        "arm": "bare-x-to-pdf-android-arm",
        "arm64": "bare-x-to-pdf-android-arm64",
        "x64": "bare-x-to-pdf-android-x64"
      },
      "darwin": {
        "arm64": "bare-x-to-pdf-darwin-arm64",
        "x64": "bare-x-to-pdf-darwin-x64"
      },
      "ios": {
        "arm64": {
          "default": "bare-x-to-pdf-ios-arm64",
          "simulator": "bare-x-to-pdf-ios-arm64-simulator"
        },
        "x64": {
          "simulator": "bare-x-to-pdf-ios-x64-simulator"
        }
      },
      "linux": {
        "arm64": "bare-x-to-pdf-linux-arm64",
        "x64": "bare-x-to-pdf-linux-x64"
      },
      "win32": {
        "x64": "bare-x-to-pdf-win32-x64"
      }
    }
  },
  "optionalDependencies": {
    "bare-x-to-pdf-android-arm": "0.2.0",
    "bare-x-to-pdf-android-arm64": "0.2.0",
    "bare-x-to-pdf-android-x64": "0.2.0",
    "bare-x-to-pdf-darwin-arm64": "0.2.0",
    "bare-x-to-pdf-darwin-x64": "0.2.0",
    "bare-x-to-pdf-ios-arm64": "0.2.0",
    "bare-x-to-pdf-ios-arm64-simulator": "0.2.0",
    "bare-x-to-pdf-ios-x64-simulator": "0.2.0",
    "bare-x-to-pdf-linux-arm64": "0.2.0",
    "bare-x-to-pdf-linux-x64": "0.2.0"
  }
}
