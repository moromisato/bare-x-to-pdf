{
  "name": "bare-x-to-pdf",
  "version": "0.1.0",
  "description": "Convert Word, PowerPoint, Excel, OpenDocument and PDF files for Bare: a Rust engine on Typst and PDFium",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "cmake",
    "core/Cargo.toml",
    "core/Cargo.lock",
    "core/src",
    "core/include",
    "fonts",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare test.js",
    "bench": "bare bench/run.js",
    "bench:text": "bare bench/text.js",
    "prebuild": "bare-make generate && bare-make build && bare-make install --prefix prebuilds"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moromisato/bare-x-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/moromisato/bare-x-to-pdf/issues"
  },
  "homepage": "https://github.com/moromisato/bare-x-to-pdf#readme",
  "keywords": [
    "bare",
    "docx",
    "pptx",
    "xlsx",
    "odf",
    "pdf",
    "typst",
    "pdfium",
    "convert"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "prettier": "prettier-config-holepunch",
  "dependencies": {
    "bare-path": "^3.0.0",
    "bare-url": "^2.4.1"
  },
  "devDependencies": {
    "bare-fs": "^4.0.0",
    "bare-pdfium": "^1.3.0",
    "bare-zlib": "^1.0.0",
    "brittle": "^3.4.0",
    "cmake-bare": "^1.8.3",
    "cmake-fetch": "^1.5.1",
    "lunte": "^1.6.0",
    "prettier": "^3.4.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
